APP_NAME="Matrix Synapse Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dashboard
DB_USERNAME=dashboard
DB_PASSWORD=change-this-db-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=database
CORE_BASE_URL=http://mx-core:8081
CORE_SERVICE_TOKEN=change-this-long-random-service-token
SYNAPSE_BASE_URL=http://synapse:8008
SYNAPSE_ADMIN_TOKEN=change-this-synapse-admin-token
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
WEB_PORT=8080
MEDIA_GATE_PORT=8082
# Optional read-only PostgreSQL DSN for Synapse message/device statistics.
SYNAPSE_DB_URL=
# Optional Synapse Prometheus exposition endpoint, e.g. http://synapse:9000/_synapse/metrics
SYNAPSE_PROMETHEUS_URL=
