APP_NAME="Matrix Synapse Dashboard"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_LOCALE=fa
APP_FALLBACK_LOCALE=en
LOG_CHANNEL=stderr
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=dashboard
DB_USERNAME=dashboard
DB_PASSWORD=change-this-db-password
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=database
SESSION_DRIVER=database
CORE_BASE_URL=http://mx-core:8081
CORE_SERVICE_TOKEN=change-this-long-random-service-token
# Populated automatically by start.sh after discovering the running Synapse container.
SYNAPSE_BASE_URL=http://synapse:8008
SYNAPSE_DOCKER_CONTAINER=
SYNAPSE_DOCKER_NETWORK=dashboard_synapse_link
# Matrix server name, e.g. example.com (not the internal Docker hostname)
SYNAPSE_SERVER_NAME=example.com
# Short localpart, e.g. ali. start.sh constructs @ali:example.com.
SYNAPSE_ADMIN_USER=
SYNAPSE_ADMIN_PASSWORD=
# Optional legacy static token; username/password login is preferred.
SYNAPSE_ADMIN_TOKEN=
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
# Optional legacy email for existing deployments.
INITIAL_ADMIN_EMAIL=
WEB_PORT=8080
MEDIA_GATE_PORT=8082
SYNAPSE_DB_URL=
SYNAPSE_PROMETHEUS_URL=
